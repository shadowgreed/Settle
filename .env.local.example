# ── Settle — Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Add each variable to your Vercel project settings (Settings → Environment Variables)
# so they are available in production.
#
# NEVER commit .env.local to git — it contains secrets.

# ── TMDB ──────────────────────────────────────────────────────────────────────
REACT_APP_TMDB_API_KEY=your_tmdb_api_key_here

# ── Watchmode ─────────────────────────────────────────────────────────────────
REACT_APP_WATCHMODE_API_KEY=your_watchmode_api_key_here

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these from Firebase console → Project settings → Your apps → Web app
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
