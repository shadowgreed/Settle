# ── Settle — Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Add each variable to your Vercel project settings (Settings → Environment Variables)
# so they are available in production.
#
# NEVER commit .env.local to git — it contains secrets.

# ── IMPORTANT: secret API keys are SERVER-SIDE, not here ──────────────────────
# TMDB, Watchmode, SerpAPI, Google Geocoding and the VAPID *private* key are
# read only by the /api serverless proxies and must NOT use the REACT_APP_
# prefix. Anything prefixed REACT_APP_ is compiled into the public browser
# bundle — prefixing a secret would leak it to every visitor. Put those keys in
# `.env` (server) / your Vercel project env instead. See `.env.example`.
#   TMDB_KEY, WATCHMODE_KEY, SERP_API_KEY, GOOGLE_GEOCODING_KEY, VAPID_PRIVATE_KEY, ...

# Only PUBLIC, client-safe values belong below (REACT_APP_*).

# ── Analytics (write-only ingest key — safe to bundle) ────────────────────────
REACT_APP_POSTHOG_KEY=your_posthog_project_api_key_here

# ── Web Push (PUBLIC VAPID key only — the private key stays server-side) ──────
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase web config is public by design (access is enforced by Firestore
# Security Rules, not by hiding these values). Safe to bundle.
# Get these from Firebase console → Project settings → Your apps → Web app
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
