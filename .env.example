# Copy this file to .env and fill in your own keys.
# NEVER commit .env to version control.
#
# Local development: run `vercel dev` (not `npm start`) so the /api proxy
# functions can read these environment variables at runtime.
# In Vercel dashboard: add TMDB_KEY and WATCHMODE_KEY under Settings → Environment Variables.

# ── Server-only (never bundled into JS) ──────────────────────────────────────
TMDB_KEY=your_tmdb_api_key_here
WATCHMODE_KEY=your_watchmode_api_key_here

# ── Client-side (safe to be in bundle — write-only analytics ingest key) ─────
REACT_APP_POSTHOG_KEY=your_posthog_project_api_key_here
